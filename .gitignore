# ============================================================
# SOLID ML Stack - Git Ignore Configuration
# ============================================================

# ============================================================
# PYTHON ENVIRONMENT
# ============================================================

# Python bytecode and cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.env/
.venv/
venv/

# ============================================================
# DEVELOPMENT TOOLS
# ============================================================

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# ============================================================
# TESTING AND COVERAGE
# ============================================================

# Test artifacts
dist/
build/
*.egg-info/
htmlcov/
.coverage*
pytest_cache/

# ============================================================
# DATA FILES
# ============================================================

# Data file formats (excluding sample data)
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.zip
*.gz
*.xz

# Database files
*.duckdb
*.db

# Keep sample and example data
!data/**/*.sample.*
!data/**/*.example.*

# ============================================================
# MACHINE LEARNING ARTIFACTS
# ============================================================

# Model files
*.pkl
*.joblib
*.onnx

# ML experiment tracking
mlruns/
experiments/

# Feature engineering
features/
metrics/

# Model training artifacts
catboost_info/
events.out.tfevents
*.tfevents.*

# Preprocessing artifacts
target/preprocessing_artifacts/

# ============================================================
# JUPYTER NOTEBOOKS
# ============================================================

# Jupyter checkpoints
.ipynb_checkpoints/

# ============================================================
# LOGS AND TEMPORARY FILES
# ============================================================

# Log files
*.log
logs/

# Temporary files
tmp/

# ============================================================
# SECURITY AND CONFIGURATION
# ============================================================

# Environment and secret files
.env.local
.env.*

# Ansible artifacts
*.retry

# ============================================================
# PROJECT-SPECIFIC EXCLUSIONS
# ============================================================

# Specific database files
data/dwh/solid_ml.duckdb

# Build artifacts
/target/

# ML results
artifacts/
artifacts/ml_results.csv
